{
  "info": {
    "_postman_id": "685945fe-2f28-405a-99d2-e4a4c8a62b39",
    "name": "ToriloShop API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "auth_token",
      "value": ""
    },
    {
      "key": "access_token",
      "value": ""
    },
    {
      "key": "refresh_token",
      "value": ""
    },
    {
      "key": "product_id",
      "value": "1"
    },
    {
      "key": "category_id",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Get Auth Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"your_username\",\n  \"password\": \"your_password\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/auth-token/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth-token",
            ""
          ]
        }
      },
      "response": []
    },
    {
      "name": "Get JWT Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"your_username\",\n  \"password\": \"your_password\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/token/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "token",
            ""
          ]
        }
      },
      "response": []
    },
    {
      "name": "Refresh JWT Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/token/refresh/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "token",
            "refresh",
            ""
          ]
        }
      },
      "response": []
    },
    {
      "name": "List Products",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/products/?category={{category_id}}&is_available=true&search=charger&ordering=price",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "products",
            ""
          ],
          "query": [
            {
              "key": "category",
              "value": "{{category_id}}"
            },
            {
              "key": "is_available",
              "value": "true"
            },
            {
              "key": "search",
              "value": "charger"
            },
            {
              "key": "ordering",
              "value": "price"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "Create Product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{auth_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"iPhone Charger\",\n  \"price\": \"15000.00\",\n  \"stock\": 20,\n  \"is_available\": true,\n  \"category_id\": {{category_id}}\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/products/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "products",
            ""
          ]
        }
      },
      "response": []
    },
    {
      "name": "Update Product",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{auth_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated iPhone Charger\",\n  \"price\": \"18000.00\",\n  \"stock\": 15,\n  \"is_available\": true,\n  \"category_id\": {{category_id}}\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/products/{{product_id}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "products",
            "{{product_id}}",
            ""
          ]
        }
      },
      "response": []
    },
    {
      "name": "Delete Product",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Authorization",
            "value": "Token {{auth_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/products/{{product_id}}/",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "products",
            "{{product_id}}",
            ""
          ]
        }
      },
      "response": []
    }
  ]
}
